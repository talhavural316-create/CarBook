@model List<CarBook.Dto.RentACarDtos.FilterRentACarDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section bg-light">
    <div class="container">
        <!-- Düzenlenmiş Şık Filtre Detayları Alanı -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <h5 class="font-weight-bold text-primary mb-2">Arama ve Kiralama Kriterleriniz</h5>
                    <div class="d-flex flex-wrap text-muted" style="gap: 20px; font-size: 15px;">
                        <div><strong>Alış Tarihi:</strong> @ViewBag.bookpickdate</div>
                        <div><strong>İade Tarihi:</strong> @ViewBag.bookoffdate</div>
                        <div><strong>Alış Saati:</strong> @ViewBag.timepick</div>
                        <div><strong>İade Saati:</strong> @ViewBag.timeoff</div>
                        <div><strong>Lokasyon No:</strong> @ViewBag.locationId</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="car-wrap rounded ftco-animate">
                            <div class="img rounded d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                            </div>
                            <div class="text">
                                <h2 class="mb-0"><a href="#">@item.Model</a></h2>
                                <div class="d-flex mb-3">
                                    <span class="cat">@item.Brand</span>
                                    <p class="price ml-auto">@item.Amount ₺ <span>/Günlük</span></p>
                                </div>
                                <p class="d-flex mb-0 d-block">
                                    <a href="#" class="btn btn-primary py-2 mr-1">Hemen Kirala</a>
                                    <a href="#" class="btn btn-secondary py-2 ml-1">Detaylar</a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-md-12 text-center">
                    <div class="alert alert-warning">Seçilen lokasyonda müsait araç bulunamadı.</div>
                </div>
            }
        </div>
    </div>
</section>