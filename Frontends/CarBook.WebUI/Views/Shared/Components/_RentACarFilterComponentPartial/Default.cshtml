<section class="ftco-section ftco-no-pt bg-light">
    <div class="container">
        <div class="row no-gutters">
            <div class="col-md-12 featured-top">
                <div class="row no-gutters">
                    <div class="col-md-4 d-flex align-items-center">
                        <form method="post" action="/Default/Index" class="request-form ftco-animate bg-primary">
                            <h2>Şimdi Aracınızı Kiralayın</h2>

                            <div class="form-group">
                                <label for="" class="label">Alınacak Lokasyon</label>
                                <select name="locationId" class="form-control" style="background-color: transparent !important; color: white !important;">
                                    <option value="" style="color: black;">Lokasyon Seçiniz</option>
                                    @if (ViewBag.v != null)
                                    {
                                        @foreach (var item in ViewBag.v as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                                        {
                                            <option value="@item.Value" style="color: black;">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="d-flex">
                                <div class="form-group mr-2">
                                    <label for="" class="label">Alınmak İstenen Tarih</label>
                                    <input type="text" name="bookpickdate" class="form-control" id="book_pick_date" placeholder="Tarih" style="color: #fff !important;">
                                </div>
                                <div class="form-group ml-2">
                                    <label for="" class="label">İade Tarihi</label>
                                    <input type="text" name="bookoffdate" class="form-control" id="book_off_date" placeholder="Tarih" style="color: #fff !important;">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="" class="label">Alış Saati</label>
                                <input type="text" name="timepick" class="form-control" id="time_pick" placeholder="Saat" style="color: #fff !important;">
                            </div>
                            <div class="form-group">
                                <label for="" class="label">İade Saati</label>
                                <input type="text" name="timeoff" class="form-control" placeholder="Saat" style="color: #fff !important;">
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-secondary py-3 px-4 w-100">Uygun Araçları Listele</button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-8 d-flex align-items-center">
                        <div class="services-wrap rounded-right w-100">
                            <h3 class="heading-section mb-4">Araç Kiralamanın En Basit Yolu</h3>
                            <div class="row d-flex mb-4">
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-route"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">Almak İstediğin Konumu Seç</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-handshake"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">En Uygun Araçları Gör</h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-self-stretch ftco-animate">
                                    <div class="services w-100 text-center">
                                        <div class="icon d-flex align-items-center justify-content-center"><span class="flaticon-rent"></span></div>
                                        <div class="text w-100">
                                            <h3 class="heading mb-2">Kiralamayı Tamamla, Hepsi Bu!</h3>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>