@model CreateReservationDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="col-md-12 block-9 mb-md-5">
    <div class="bg-light p-5 contact-form">
        <h3 class="alert alert-success">Araç Rezervasyon Formu</h3>
        <form method="post">

            <input type="hidden" asp-for="CarId" value="@ViewBag.v3" />

            <div class="form-group">
                <label>Adınız</label>
                <input type="text" asp-for="Name" class="form-control" placeholder="Adınız" />
            </div>

            <div class="form-group">
                <label>Soyadınız</label>
                <input type="text" asp-for="Surname" class="form-control" placeholder="Soyadınız" />
            </div>

            <div class="form-group">
                <label>Mail Adresiniz</label>
                <input type="text" asp-for="Email" class="form-control" placeholder="Mail Adresiniz" />
            </div>

            <div class="form-group">
                <label>Telefon Numaranız</label>
                <input type="text" asp-for="Phone" class="form-control" placeholder="Telefon Numaranız" />
            </div>

            <div class="form-group">
                <label>Alınmak İstenen Lokasyon</label>
                @Html.DropDownListFor(x => x.PickUpLocationId, (List<SelectListItem>)ViewBag.v, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>İade Edilecek Lokasyon</label>
                @Html.DropDownListFor(x => x.DropOffLocationId, (List<SelectListItem>)ViewBag.v, new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Yaşınız</label>
                <input type="text" asp-for="Age" class="form-control" placeholder="Yaşınız" />
            </div>

            <div class="form-group">
                <label>Ehliyet Yılınız</label>
                <input type="text" asp-for="DriverLicenseYear" class="form-control" placeholder="Ehliyet Yılınız" />
            </div>

            <div class="form-group">
                <label>Açıklama</label>
                <textarea asp-for="Description" cols="30" rows="7" class="form-control" placeholder="Varsa Eklemek İstedikleriniz"></textarea>
            </div>

            <div class="form-group">
                <input type="submit" value="Rezervasyonu Tamamla" class="btn btn-primary py-3 px-5" />
            </div>

        </form>
    </div>
</div>