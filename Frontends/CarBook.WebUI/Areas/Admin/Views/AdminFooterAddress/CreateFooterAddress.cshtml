@using CarBook.Dto.FooterAddressDtos
@model CreateFooterAddressDto

@{
    ViewData["Title"] = "CreateFooterAddress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni İletişim & Footer Adres Girişi</h4>
                        <p class="card-subtitle mb-4">
                            Web sitesinin alt kısmında ve iletişim sayfasında görünecek adres, telefon, e-posta ve açıklama bilgilerini bu formdan ekleyebilirsiniz.
                        </p>
                        <form method="post">
                            <div class="form-group">
                                <label for="address">Adres</label>
                                <input type="text" class="form-control" id="address" asp-for="Address" placeholder="Adres bilgisini giriniz">
                            </div>
                            <div class="form-group">
                                <label for="phone">Telefon</label>
                                <input type="text" class="form-control" id="phone" asp-for="Phone" placeholder="Telefon numarasını giriniz">
                            </div>
                            <div class="form-group">
                                <label for="email">E-posta</label>
                                <input type="email" class="form-control" id="email" asp-for="Email" placeholder="E-posta adresini giriniz">
                            </div>
                            <div class="form-group">
                                <label for="description">Açıklama</label>
                                <textarea class="form-control" id="description" asp-for="Description" rows="4" placeholder="Kısa bir açıklama giriniz"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Adres Bilgisini Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>