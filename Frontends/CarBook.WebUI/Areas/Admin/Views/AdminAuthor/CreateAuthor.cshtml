@using CarBook.Dto.AuthorDtos
@model CreateAuthorDto
@{
    ViewData["Title"] = "CreateAuthor";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Yeni Yazar Girişi</h4>
                        <p class="card-subtitle mb-4">
                            Yazar bilgilerini eksiksiz bir şekilde aşağıdaki form üzerinden ekleyebilirsiniz.
                        </p>
                        <form method="post">
                            <div class="form-group">
                                <label for="exampleInputName">Yazar Adı Soyadı</label>
                                <input type="text" class="form-control" id="exampleInputName" asp-for="Name" placeholder="Ad Soyad Giriniz">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputImageUrl">Yazar Görsel URL</label>
                                <input type="text" class="form-control" id="exampleInputImageUrl" asp-for="ImageUrl" placeholder="Fotoğraf Bağlantısını Giriniz">
                            </div>
                            <div class="form-group">
                                <label for="exampleInputDescription">Yazar Biyografisi / Açıklama</label>
                                <textarea rows="5" class="form-control" id="exampleInputDescription" asp-for="Description" placeholder="Yazar Hakkında Bilgi Giriniz"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary waves-effect waves-light">Yazarı Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>